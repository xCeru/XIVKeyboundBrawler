<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>0.1.1.0</Version>
    <Author>XIVKeyboundBrawler</Author>
    <Name>XIVKeyboundBrawler</Name>
    <Punchline>Auto-types words in Keybound Brawler mini-game</Punchline>
    <Description>Detects words above enemies in the Keybound Brawler Gold Saucer mini-game and automatically types them with configurable delays and randomization.</Description>
    <RepoUrl>https://github.com/xCeru/XIVKeyboundBrawler</RepoUrl>
    <Tags>keybound;brawler;gold-saucer;typing;automation</Tags>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup>
    <DalamudLibPath Condition="'$(DalamudLibPath)' == ''">$(AppData)\XIVLauncher\addon\Hooks\dev\</DalamudLibPath>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Data\icon.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="FFXIVClientStructs">
      <HintPath>$(DalamudLibPath)FFXIVClientStructs.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <PackageReference Include="InputSimulatorCore" Version="1.0.5" />
  </ItemGroup>
</Project>